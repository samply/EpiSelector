# Docker environment variables (copy to .env)

# Used by docker-compose.yml. Letters and digits only, because it is also put into DATABASE_URL.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Django settings (secret key, debug, allowed hosts) live in a file that docker-compose mounts into the container.
# Default: config/django/local_settings.dev.py. For a deployment, copy config/django/local_settings.prod.example.py
# to config/django/local_settings.prod.py (gitignored), fill it in, and uncomment:
# DJANGO_LOCAL_SETTINGS=./config/django/local_settings.prod.py

# API URLs
# Only used when building the frontend; leave empty when nginx forwards /api/ and /control_selection/ to Django
# REACT_APP_API_URL=
R_BACKEND_URL=http://localhost:3420

# Docker Tag
EPISELECTOR_IMAGE_TAG=englishversion-en
